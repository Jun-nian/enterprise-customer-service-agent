# ===========================================
# 企业智能客服 Agent 环境变量配置
# 复制此文件为 .env 并填入你的密钥
# ===========================================

# LLM 类型: deepseek / openai / oneapi / qwen / ollama
LLM_TYPE=ollama

# ---------- DeepSeek ----------
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=sk-your-key
# DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---------- OpenAI ----------
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-key
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- OneAPI ----------
# ONEAPI_API_BASE=
# ONEAPI_API_KEY=
# ONEAPI_CHAT_MODEL=qwen-max
# ONEAPI_EMBEDDING_MODEL=text-embedding-v1

# ---------- 通义千问 ----------
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_API_KEY=
# QWEN_CHAT_MODEL=qwen-max
# QWEN_EMBEDDING_MODEL=text-embedding-v1

# ---------- Ollama (本地) ----------
# OLLAMA_API_BASE=http://localhost:11434/v1
# OLLAMA_CHAT_MODEL=qwen2.5:7b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# ---------- 嵌入模型独立覆盖 (可选) ----------
# 如果聊天和嵌入使用不同后端，在这里覆盖
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_API_BASE=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text:latest

# ---------- LangSmith (可选) ----------
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=

# ===========================================
# 08 版新增能力开关（P0-A 规划 / P0-C 护栏 / P1-B 可靠性）
# 全部默认关闭，保持与 07 版完全一致的行为；按需开启
# ===========================================

# ---------- P0-A 规划范式 (Plan-and-Execute) ----------
# 开启后：复杂查询走 planner→executor→critic 多步执行 + 动态重规划；
# 简单查询仍走原快路径（agent 单轮工具决策）
# ENABLE_PLANNING=false
# 动态重规划上限（防无限循环）
# PLAN_MAX_REPLAN=2

# ---------- P0-C 安全护栏 (guardrails) ----------
# 开启后：输入侧 7 类攻击范式检测 + 输出侧 PII 脱敏 + 越权校验 + 审计日志
# ENABLE_GUARDRAILS=false
# 护栏模式：block=命中即拒答 / flag=命中降级为受限回答
# GUARD_MODE=block
# 审计日志开关（随护栏开启默认启用）
# ENABLE_AUDIT=true

# ---------- P1-B 工具可靠性 (reliability) ----------
# 开启后：工具调用注入 超时/重试(指数退避)/失败降级/熔断
# ENABLE_RELIABILITY=false
# 工具单次调用超时（秒）
# TOOL_TIMEOUT_SECONDS=20
# 工具最大重试次数
# TOOL_MAX_RETRIES=2
